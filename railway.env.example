# ─────────────────────────────────────────────────────────────
#  AutoCliper — Railway environment variables
#  Copy these into your Railway service's Variables tab.
#  Lines starting with # are comments; do NOT copy them as-is.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# Set by Railway automatically — do NOT override.
# PORT=

# Your production domain (used for CORS allow-list).
ALLOWED_ORIGIN=https://autocliper.com

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS

# Runtime mode — must be "production" on Railway.
NODE_ENV=production

# ── Database (add Railway PostgreSQL plugin) ──────────────────
# Railway injects this automatically when you add a Postgres plugin.
# DATABASE_URL=postgresql://...

# ── Persistent clip storage (choose ONE backend) ──────────────
#
# Option A — S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO …)
#   Clips are uploaded to S3 and survive Railway restarts/redeploys.
#   R2 example:
#     S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#     S3_BUCKET=autocliper-clips
#     S3_ACCESS_KEY=<R2 Access Key ID>
#     S3_SECRET_KEY=<R2 Secret Access Key>
#     S3_REGION=auto          # R2 ignores region; use "auto"
#   AWS S3 example (omit S3_ENDPOINT):
#     S3_BUCKET=autocliper-clips
#     S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
#     S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#     S3_REGION=us-east-1
#
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
#
# Option B — Railway persistent volume
#   Attach a volume to your service and set CLIPS_DIR to its mount path.
#   This keeps clips on a persistent disk without requiring an external bucket.
#   CLIPS_DIR=/data/clips
#
# Option C — ephemeral /tmp (default, no config needed)
#   Clips live only in the process's /tmp and are wiped on every restart.
#   Suitable for dev/testing only.

# ── Optional ──────────────────────────────────────────────────

# Maximum storage usage in GB before old clips are evicted (applies to S3/volume backends).
# Default: 5
# STORAGE_SIZE_CAP_GB=5

# Absolute path to the yt-dlp binary.
# Not needed if the binary is on PATH (e.g. installed to /usr/local/bin by the build step).
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Log level for pino (trace | debug | info | warn | error | fatal).
# Default: info
# LOG_LEVEL=info
