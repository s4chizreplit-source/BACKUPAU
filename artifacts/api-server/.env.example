# AutoCliper API server — environment reference (copy to .env / systemd env file)

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/autocliper
SESSION_SECRET=change-me-64-hex-chars
CLIPS_DIR=/var/lib/autocliper/clips

# Public base URL of the app (REQUIRED in production — used for social media
# URLs, the Post for Me OAuth callback and webhook registration)
PUBLIC_APP_URL=https://autocliper.pro

# ── Providers ─────────────────────────────────────────────────────────────────
# Video download API (zylalabs.com)
ZYLA_API_KEY=
# Speech-to-text for captions (deepgram.com)
DEEPGRAM_API_KEY=
# UPI payments (zapupi.com)
ZAPUPI_ZAP_KEY=
# Social auto-posting (postforme.dev) — server-side only, never expose to the client
POSTFORME_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Transactional email (resend.com) — password resets
RESEND_API_KEY=
# Comma-separated admin emails
ADMIN_EMAILS=
# Disk cap for stored clips (GB)
STORAGE_SIZE_CAP_GB=
